resource app_signature "application/x-vnd.Folio";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Folio",
	long_info = "Folio: notebooks in Markdown with links that follow renames"
};

resource file_types message {
	"types" = "text/markdown",
	"types" = "text/x-markdown"
};
