# haiku-app.env — what the beos-app-platforms release tools need to know about this app.
# Shell syntax: sourced by packaging/*.sh, the CI workflow and the
# release scripts (check-artifact.sh, release-gate.sh). Keep values quoted; no spaces around '='.

# ── Identity ──
APP_NAME="Folio"                       # binary name = window/team name
APP_CMD="folio"                        # package name and command, lowercase
APP_SIG="application/x-vnd.Folio"      # must equal the .rdef app_signature
RDEF="Folio.rdef"                      # path of the resource definition

# ── Version (also in the .rdef app_version and packaging/debian/changelog) ──
VERSION="0.1.4"
REVISION="1"

# ── Package metadata ──
SUMMARY="Notebooks in Markdown with links that follow renames"
DESCRIPTION_FILE="packaging/description.txt"   # plain text; blank line = paragraph
HOMEPAGE="https://github.com/idumych/folio"
GITHUB_REPO="idumych/folio"
LICENSE_NAME="MIT"                     # a name from /boot/system/data/licenses on Haiku
COPYRIGHT="2026 the Folio authors"
PACKAGER="idumych <19998719+idumych@users.noreply.github.com>"

# Extra runtime dependencies beyond the Haiku API itself
HPKG_REQUIRES_EXTRA=""
DEB_DEPENDS_EXTRA=""
DEB_SECTION="editors"
DESKTOP_CATEGORIES="Office;TextEditor;"
APPIMAGE_MUST_BUNDLE=""
APPIMAGE_FONTS_EXTRA=""
COSMOE_REPO=""                         # "" = idumych/hokku
COSMOE_TAG=""                          # "" = hokku
APPIMAGE_APT_EXTRA=""
DEB_APT_EXTRA=""

# ── Build ──
HPKG_BUILD_DEPS=""
TEST_CMD="make test"
TYPECHECK_SRCS="src/App.cpp src/MainWindow.cpp src/NoteView.cpp src/Widgets.cpp src/Vault.cpp"
TYPECHECK_INCLUDES=""

# ── Feature test (the app-specific part of release/test-plan.md) ──
FEATURE_CHECKS="welcome rename-links external-move"
# {p}-tree.txt: `find ~/Notebooks -name '*.md'` after the first launch
EVIDENCE_1="{p}-tree.txt|Welcome/Getting Started/Links and Renaming\.md"
# {p}-links-rename.txt: grep -o '\[\[[^]]*\]\]' of Links and Renaming.md after renaming in the app
EVIDENCE_2="{p}-links-rename.txt|\[\[Renamed {p}\|the welcome page\]\]"
# {p}-links-move.txt: the same grep after mv of that page in a terminal
EVIDENCE_3="{p}-links-move.txt|\[\[Moved {p}#Links\]\]"
