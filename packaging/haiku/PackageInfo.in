name			folio
version			@VERSION@
architecture	@ARCH@
summary			"Notebooks in Markdown with links that follow renames"
description		"Folio is a native notebook app for Haiku in the spirit of OneNote: \
notebooks, sections and pages in a tree, with pages stored as plain Markdown \
files.

Pages link to each other with Obsidian-style [[wiki links]]. Renaming or \
moving a page, section or notebook - in Folio, Tracker or a terminal - \
rewrites every link that pointed to it. Also: backlinks, #tags, to-do \
checkboxes, full-text search and drag-and-drop attachments."
packager		"@PACKAGER@"
vendor			"Folio"
copyrights		{
	"2026 the Folio authors"
}
licenses		{
	"MIT"
}
urls			{
	"https://github.com/idumych/folio"
}

provides		{
	folio = @PVERSION@
	app:Folio = @PVERSION@
	cmd:folio
}
requires		{
	haiku >= r1~beta6
}
